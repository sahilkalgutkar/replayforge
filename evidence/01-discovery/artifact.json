  "outcomes": [
    {
      "name": "MEMBER_NOT_FOUND",
      "description": "The core holds no member with that number. The search screen reports it in place of a results table; this is a legitimate answer to the caller's question, not a failure.",
      "when": {
        "kind": "textPresent",
        "text": {
          "mode": "contains",
          "value": "No records found"
        }
      },
      "terminal": true,
      "disposition": "answer"
    },
    {
      "name": "ACCESS_DENIED",
      "description": "The signed-on teller profile is not entitled to this member record. Detected by HTTP status as well as wording, since the status does not depend on how the vendor phrases the message.",
      "when": {
        "kind": "any",
        "of": [
          {
            "kind": "textPresent",
            "text": {
              "mode": "contains",
              "value": "Access denied"
            }
          },
          {
            "kind": "httpStatusIn",
            "statuses": [
              403
            ]
          }
        ]
      },
      "terminal": true,
      "disposition": "needs_human"
    },
    {
      "name": "SESSION_EXPIRED",
      "description": "The console signed the service session out part-way through the flow. A replay cannot sign itself back in safely, so a person has to.",
      "when": {
        "kind": "any",
        "of": [
          {
            "kind": "textPresent",
            "text": {
              "mode": "contains",
              "value": "session has expired"
            }
          },
          {
            "kind": "httpStatusIn",
            "statuses": [
              401
            ]
          }
        ]
      },
      "terminal": true,
      "disposition": "needs_human"
    },
    {
      "name": "CORE_UNAVAILABLE",
      "description": "The core returned an error page instead of a screen. Detected by status code, which is wording-independent.",
      "when": {
        "kind": "any",
        "of": [
          {
            "kind": "textPresent",
            "text": {
              "mode": "contains",
              "value": "An unexpected error occurred"
            }
          },
          {
            "kind": "httpStatusIn",
            "statuses": [
              500,
              502,
              503
            ]
          }
        ]
      },
      "terminal": true,
      "disposition": "needs_human"
    }
  ],
