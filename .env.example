# Model access for the discovery run. Replay never reads this.
ANTHROPIC_API_KEY=sk-ant-...
REPLAYFORGE_MODEL=claude-sonnet-5

# Host ports. Every published port is overridable so a busy machine can still
# run the quickstart.
TARGET_HOST_PORT=4310
TARGET_VARIANT_HOST_PORT=4311
OPERATOR_HOST_PORT=4320

# Credentials for the demo back-office app. These are fake, local-only, and are
# resolved at replay time through secretRef — they are never written into an
# artifact or an evidence log.
MERIDIAN_USERNAME=teller01
MERIDIAN_PASSWORD=demo-pass-01
